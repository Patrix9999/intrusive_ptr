{
	"version": 3,
	"configurePresets": [
		{
			"name": "windows",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"installDir": "${sourceDir}/out/install/${presetName}",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"installDir": "${sourceDir}/out/install/${presetName}",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "wsl",
			"inherits": "linux",
			"hidden": true,
			"condition": true,
			"vendor": {
				"jetbrains.com/clion": {
					"toolchain": "WSL"
				}
			}
		},

		{
			"name": "x86",
			"hidden": true,
			"architecture": {
				"value": "x86",
				"strategy": "external"
			},
			"cacheVariables": {
				"OUT_FILE_SUFFIX": "x86"
			},
			"vendor": {
				"jetbrains.com/clion": {
					"toolchain": "Visual Studio x86"
				}
			}
		},
		{
			"name": "x64",
			"hidden": true,
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"OUT_FILE_SUFFIX": "x64"
			},
			"vendor": {
				"jetbrains.com/clion": {
					"toolchain": "Visual Studio x64"
				}
			}
		},

		{
			"name": "msvc-cl",
			"hidden": true,
			"cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
		},
		{
			"name": "msvc-clang-cl",
			"hidden": true,
			"cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl.exe",
                "CMAKE_CXX_COMPILER": "clang-cl.exe"
            }
		},
		{
			"name": "gcc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_FLAGS": "-static-libgcc -static-libstdc++"
			}
		},

		{
			"name": "debug",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "relwithdebinfo",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "release",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},

		{ "name": "msvc-x86-debug", "inherits": [ "windows", "msvc-cl", "x86", "debug" ] },
		{ "name": "msvc-x86-release", "inherits": [ "windows", "msvc-cl", "x86", "release" ] },
		{ "name": "msvc-x64-debug", "inherits": [ "windows", "msvc-cl", "x64", "debug"] },
		{ "name": "msvc-x64-release", "inherits": [ "windows", "msvc-cl", "x64", "release"] },
		{ "name": "msvc-clang-x86-debug", "inherits": [ "windows", "msvc-clang-cl", "x86", "debug" ] },
		{ "name": "msvc-clang-x86-release", "inherits": [ "windows", "msvc-clang-cl", "x86", "release" ] },
		{ "name": "msvc-clang-x64-debug", "inherits": [ "windows", "msvc-clang-cl", "x64", "debug"] },
		{ "name": "msvc-clang-x64-release", "inherits": [ "windows", "msvc-clang-cl", "x64", "release"] },
		{ "name": "gcc-x64-debug", "inherits": [ "linux", "gcc", "x64", "debug" ] },
		{ "name": "gcc-x64-release", "inherits": [ "linux", "gcc", "x64", "release" ] },
		{ "name": "wsl-gcc-x64-debug", "inherits": [ "wsl", "gcc", "x64", "debug" ] },
		{ "name": "wsl-gcc-x64-release", "inherits": [ "wsl", "gcc", "x64", "release" ] }
	],
	"buildPresets": [
		{ "name": "msvc-x86-debug", "configurePreset": "msvc-x86-debug" },
		{ "name": "msvc-x86-release", "configurePreset": "msvc-x86-release" },
		{ "name": "msvc-x64-debug", "configurePreset": "msvc-x64-debug" },
		{ "name": "msvc-x64-release", "configurePreset": "msvc-x64-release" },
		{ "name": "msvc-clang-x86-debug", "configurePreset": "msvc-clang-x86-debug" },
		{ "name": "msvc-clang-x86-release", "configurePreset": "msvc-clang-x86-release" },
		{ "name": "msvc-clang-x64-debug", "configurePreset": "msvc-clang-x64-debug" },
		{ "name": "msvc-clang-x64-release", "configurePreset": "msvc-clang-x64-release" },
		{ "name": "gcc-x64-debug", "configurePreset": "gcc-x64-debug" },
		{ "name": "gcc-x64-release", "configurePreset": "gcc-x64-release" },
		{ "name": "wsl-gcc-x64-debug", "configurePreset": "wsl-gcc-x64-debug" },
		{ "name": "wsl-gcc-x64-release", "configurePreset": "wsl-gcc-x64-release" }
	]
}